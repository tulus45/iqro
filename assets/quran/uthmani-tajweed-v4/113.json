{"surah":113,"ayahs":["قُلْ أَعُوذُ بِرَبِّ <span class=\"tajweed tajweed-ham_wasl\">ٱ</span>لْفَلَ<span class=\"tajweed tajweed-qalaqah\">قِ</span>","مِ<span class=\"tajweed tajweed-ikhafa\">ن شَ</span>رِّ مَا خَلَ<span class=\"tajweed tajweed-qalaqah\">قَ</span>","وَمِ<span class=\"tajweed tajweed-ikhafa\">ن شَ</span>رِّ غَاسِقٍ إِذَا وَقَ<span class=\"tajweed tajweed-qalaqah\">بَ</span>","وَمِ<span class=\"tajweed tajweed-ikhafa\">ن شَ</span>رِّ <span class=\"tajweed tajweed-ham_wasl\">ٱ</span><span class=\"tajweed tajweed-laam_shamsiyah\">ل</span><span class=\"tajweed tajweed-ghunnah\">نَّ</span><span class=\"tajweed tajweed-madda_normal\">فَّٰثَٰ</span>تِ فِى <span class=\"tajweed tajweed-ham_wasl\">ٱ</span>لْعُقَ<span class=\"tajweed tajweed-qalaqah\">دِ</span>","وَمِ<span class=\"tajweed tajweed-ikhafa\">ن شَ</span>رِّ حَاسِدٍ إِذَا حَسَ<span class=\"tajweed tajweed-qalaqah\">دَ</span>"]}