{"surah":102,"ayahs":["أَلْ<span class=\"tajweed tajweed-madda_normal\">هَٰ</span>كُمُ <span class=\"tajweed tajweed-ham_wasl\">ٱ</span><span class=\"tajweed tajweed-laam_shamsiyah\">ل</span>تَّكَاثُرُ","حَتَّىٰ زُرْتُمُ <span class=\"tajweed tajweed-ham_wasl\">ٱ</span>لْمَقَابِرَ","كَلَّا سَوْفَ تَعْلَ<span class=\"tajweed tajweed-madda_permissible\">مُو</span>نَ","ثُ<span class=\"tajweed tajweed-ghunnah\">مَّ</span> كَلَّا سَوْفَ تَعْلَ<span class=\"tajweed tajweed-madda_permissible\">مُو</span>نَ","كَلَّا لَوْ تَعْلَمُونَ عِلْمَ <span class=\"tajweed tajweed-ham_wasl\">ٱ</span>لْيَ<span class=\"tajweed tajweed-madda_permissible\">قِي</span>نِ","لَتَرَوُ<span class=\"tajweed tajweed-ghunnah\">نَّ</span> <span class=\"tajweed tajweed-ham_wasl\">ٱ</span>لْجَ<span class=\"tajweed tajweed-madda_permissible\">حِي</span>مَ","ثُ<span class=\"tajweed tajweed-ghunnah\">مَّ</span> لَتَرَوُ<span class=\"tajweed tajweed-ghunnah\">نَّ</span>هَا عَيْنَ <span class=\"tajweed tajweed-ham_wasl\">ٱ</span>لْيَ<span class=\"tajweed tajweed-madda_permissible\">قِي</span>نِ","ثُ<span class=\"tajweed tajweed-ghunnah\">مَّ</span> لَتُسْــَٔلُ<span class=\"tajweed tajweed-ghunnah\">نَّ</span> يَوْمَئِذٍ عَنِ <span class=\"tajweed tajweed-ham_wasl\">ٱ</span><span class=\"tajweed tajweed-laam_shamsiyah\">ل</span><span class=\"tajweed tajweed-ghunnah\">نَّ</span><span class=\"tajweed tajweed-madda_permissible\">عِي</span>مِ"]}